# Copy to backend/.env for local dev. Never commit real values.
OPENROUTER_API_KEY=sk-or-v1-...
MODEL_FAST=anthropic/claude-haiku-5.5
MODEL_SMART=anthropic/claude-sonnet-5.5
SPEND_CAP_USD=18

# Optional: Qdrant Cloud. Empty = embedded on-disk Qdrant at QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=

# Optional: Postgres (Railway). Empty = SQLite file next to the code.
DATABASE_URL=

JWT_SECRET=change-me-long-random
ADMIN_TOKEN=change-me
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
